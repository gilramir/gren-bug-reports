+{-| Like `scopeIndentToLineStart`, but uses `max(indent, lineStart - 1)` so tokens at
+the same column as the current line start are still accepted by `checkIndent`. This matches
+the Haskell compiler's behavior for function-argument parsing: multi-line arguments may
+appear at the same column as the function name, but the indent can never drop below the
+enclosing declaration's column (which prevents col-1 tokens on same-line calls from being
+treated as arguments).
+-}
+scopeIndentBelowLineStart : Parser Context e v -> Parser Context e v
+scopeIndentBelowLineStart p =
+    Parser.scopedUpdatePayload
+        (\pl -> max pl.indent (pl.lineStart - 1))
+        .indent
+        (\newIndent payload -> { payload | indent = newIndent })
+        p
     
 
