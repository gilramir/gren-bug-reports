module Case2 exposing (..)


{-| 2. Comment around `->`

A block comment that intuitively should be accepted as inter-token
whitespace is rejected by the Gren parser. The "WORKS" example parses
today; the "REJECTED" case should parse but doesn't.

The signature/alias-body asymmetry suggests the signature type parser
consumes inter-token block comments correctly but the alias-body type
parser does not.
-}


-- WORKS in a function signature.

worksArrowInSig : Int {- c -} -> String
worksArrowInSig _ =
    ""


-- REJECTED in a type alias body.

type alias RejectedArrowInAlias =
    Int {- c -} -> String -> Bool
