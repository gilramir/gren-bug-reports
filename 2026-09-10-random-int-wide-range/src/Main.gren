module Main exposing (main)

import Bitwise
import Node
import Random
import Stream
import Task exposing (Task)


{-| `Random.int` picks between two algorithms with

    if (Bitwise.and (range - 1) range) == 0 then

and masks with `range - 1` when the answer is yes. `Bitwise.and` is JavaScript
`&`, which coerces each operand to a signed 32-bit integer on its own. An `Int`
is a float64 and holds far more, so for a range of 2^32 or wider both the test
and the mask are answers about `range` modulo 2^32 rather than about `range`.
-}
main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram (\env -> Node.endSimpleProgram (emit env))


emit : Node.Environment -> Task Never {}
emit env =
    report
        |> (\text -> Stream.writeLineAsBytes text env.stdout)
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


type alias Case =
    { name : String, hi : Int, range : String, note : String, ok : Bool }


cases : Array Case
cases =
    [ { name = "int 0 0xFFFFFFFF", hi = 0xFFFFFFFF, range = "2^32", note = "all of it", ok = True }
    , { name = "int 0 0x1FFFFFFFF", hi = 0x01FFFFFFFF, range = "2^33", note = "the low half", ok = False }
    , { name = "int 0 0x7FFFFFFF", hi = 0x7FFFFFFF, range = "2^31", note = "all of it", ok = True }
    , { name = "int 0 0x17FFFFFFF", hi = 0x017FFFFFFF, range = "1.5 * 2^32", note = "the low third", ok = False }
    , { name = "int 0 0x100000000", hi = 0x0100000000, range = "2^32 + 1", note = "only 0", ok = False }
    , { name = "int 0 0x100000001", hi = 0x0100000001, range = "2^32 + 2", note = "only 0 and 1", ok = False }
    ]


{-| Four columns wide, so a reader never has to work out which rows are the
good ones.
-}
marker : Case -> String
marker c =
    if c.ok then
        "ok  "

    else
        "BAD "


{-| 48 divides by both 2 and 3, so every boundary below falls exactly on a
bucket edge and no bucket is left partly covered.
-}
bucketCount : Int
bucketCount =
    48


drawCount : Int
drawCount =
    20000


{-| The requested interval [lo, hi] cut into equal buckets, and how many of
`drawCount` draws land in each.
-}
buckets : Int -> Int -> Array Int
buckets lo hi =
    let
        range =
            hi - lo + 1
    in
    Array.foldl
        (\_ acc ->
            let
                drawn =
                    Random.step (Random.int lo hi) acc.seed

                index =
                    (drawn.value - lo) * bucketCount // range
            in
            { seed = drawn.seed
            , counts =
                Array.indexedMap
                    (\i c ->
                        if i == index then
                            c + 1

                        else
                            c
                    )
                    acc.counts
            }
        )
        { seed = Random.initialSeed 7, counts = Array.repeat bucketCount 0 }
        (Array.range 1 drawCount)
        |> .counts


stripRow : Case -> String
stripRow c =
    let
        counts =
            buckets 0 c.hi

        drawn =
            counts
                |> Array.map
                    (\n ->
                        if n > 0 then
                            "#"

                        else
                            "."
                    )
                |> String.join ""
    in
    "  " ++ marker c ++ String.padRight 19 ' ' c.name ++ drawn ++ "  " ++ c.note


report : String
report =
    String.join "\n"
        (Array.flatten
            [ [ "`ok` marks a call that reaches its whole requested interval; `BAD` one"
              , "that does not. Each BAD row is some narrower call answered exactly;"
              , "for two of them that narrower call is in the table too."
              , ""
              , ""
              , "What `int`'s test and mask actually compute. `Bitwise.and` coerces to"
              , "int32, so both are answers about `range` modulo 2^32."
              , ""
              , "      call                 range         range mod 2^32   (range-1) & range         mask"
              ]
            , Array.map decisionRow cases
            , [ ""
              , ""
              , "Five draws from Random.initialSeed 7, ordered so that the pairs the"
              , "truncation makes indistinguishable sit next to each other:"
              , ""
              ]
            , Array.map drawRow cases
            , [ ""
              , ""
              , "Where the draws land. Each row is that call's own requested interval"
              , "cut into " ++ String.fromInt bucketCount ++ " equal buckets, left edge 0 and right edge hi, with"
              , String.fromInt drawCount ++ " draws dropped into it. A bucket that ever received a draw is"
              , "`#`; one that never did is `.`."
              , ""
              ]
            , Array.map stripRow cases
            , [ ""
              , flatness
              ]
            ]
        )


{-| The draws are not merely concentrated in the low part of the interval: they
are flat across it and absent above it. Reported for the 1.5 * 2^32 row.
-}
flatness : String
flatness =
    let
        occupied =
            buckets 0 0x017FFFFFFF
                |> Array.keepIf (\n -> n > 0)

        low =
            Array.foldl min drawCount occupied

        high =
            Array.foldl max 0 occupied
    in
    "Within the part it reaches the draws are flat, not merely concentrated: for\n"
        ++ "the 1.5 * 2^32 row the "
        ++ String.fromInt (Array.length occupied)
        ++ " occupied buckets took between "
        ++ String.fromInt low
        ++ " and "
        ++ String.fromInt high
        ++ "\nof the "
        ++ String.fromInt drawCount
        ++ " draws, and the other "
        ++ String.fromInt (bucketCount - Array.length occupied)
        ++ " took none."


decisionRow : Case -> String
decisionRow c =
    let
        range =
            c.hi + 1
    in
    "  "
        ++ marker c
        ++ String.padRight 21 ' ' c.name
        ++ String.padRight 14 ' ' c.range
        ++ String.padLeft 14 ' ' (String.fromInt (modulo32 range))
        ++ String.padLeft 20 ' ' (String.fromInt (Bitwise.and (range - 1) range))
        ++ String.padLeft 13 ' ' (String.fromInt (Bitwise.shiftRightZfBy 0 (Bitwise.and (range - 1) 0xFFFFFFFF)))


{-| `range` modulo 2^32, done in float arithmetic so it is not itself truncated.
-}
modulo32 : Int -> Int
modulo32 n =
    n - 4294967296 * (n // 4294967296)


drawRow : Case -> String
drawRow c =
    "  " ++ marker c ++ String.padRight 19 ' ' c.name ++ draws 0 c.hi


draws : Int -> Int -> String
draws lo hi =
    Array.foldl
        (\_ acc ->
            let
                drawn =
                    Random.step (Random.int lo hi) acc.seed
            in
            { out = acc.out ++ [ String.padLeft 11 ' ' (String.fromInt drawn.value) ], seed = drawn.seed }
        )
        { out = [], seed = Random.initialSeed 7 }
        [ 1, 2, 3, 4, 5 ]
        |> .out
        |> String.join ""
