module Main exposing (main)

import Bitwise
import Node
import Random
import Stream
import Task exposing (Task)


{-| `Random.int` picks between two algorithms with

    if (Bitwise.and (range - 1) range) == 0 then

and masks with `range - 1` when the answer is yes. `Bitwise.and` is JavaScript
`&`, which coerces each operand to a signed 32-bit integer on its own. An `Int`
is a float64 and holds far more, so for a range of 2^32 or wider both the test
and the mask are answers about `range` modulo 2^32 rather than about `range`.
-}
main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram (\env -> Node.endSimpleProgram (emit env))


emit : Node.Environment -> Task Never {}
emit env =
    report
        |> (\text -> Stream.writeLineAsBytes text env.stdout)
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})


cases : Array { name : String, hi : Int, range : String }
cases =
    [ { name = "int 0 0xFFFFFFFF", hi = 0xFFFFFFFF, range = "2^32" }
    , { name = "int 0 0x1FFFFFFFF", hi = 0x01FFFFFFFF, range = "2^33" }
    , { name = "int 0 0x7FFFFFFF", hi = 0x7FFFFFFF, range = "2^31" }
    , { name = "int 0 0x17FFFFFFF", hi = 0x017FFFFFFF, range = "1.5 * 2^32" }
    , { name = "int 0 0x100000000", hi = 0x0100000000, range = "2^32 + 1" }
    , { name = "int 0 0x100000001", hi = 0x0100000001, range = "2^32 + 2" }
    ]


report : String
report =
    String.join "\n"
        (Array.flatten
            [ [ "What `int`'s test and mask actually compute. `Bitwise.and` coerces to"
              , "int32, so both are answers about `range` modulo 2^32."
              , ""
              , "  call                 range         range mod 2^32   (range-1) & range         mask"
              ]
            , Array.map decisionRow cases
            , [ ""
              , ""
              , "Six draws from Random.initialSeed 7, ordered so that the pairs the"
              , "truncation makes indistinguishable sit next to each other:"
              , ""
              ]
            , Array.map drawRow cases
            ]
        )


decisionRow : { name : String, hi : Int, range : String } -> String
decisionRow c =
    let
        range =
            c.hi + 1
    in
    "  "
        ++ String.padRight 21 ' ' c.name
        ++ String.padRight 14 ' ' c.range
        ++ String.padLeft 14 ' ' (String.fromInt (modulo32 range))
        ++ String.padLeft 20 ' ' (String.fromInt (Bitwise.and (range - 1) range))
        ++ String.padLeft 13 ' ' (String.fromInt (Bitwise.shiftRightZfBy 0 (Bitwise.and (range - 1) 0xFFFFFFFF)))


{-| `range` modulo 2^32, done in float arithmetic so it is not itself truncated.
-}
modulo32 : Int -> Int
modulo32 n =
    n - 4294967296 * (n // 4294967296)


drawRow : { name : String, hi : Int, range : String } -> String
drawRow c =
    "  " ++ String.padRight 21 ' ' c.name ++ draws 0 c.hi


draws : Int -> Int -> String
draws lo hi =
    Array.foldl
        (\_ acc ->
            let
                drawn =
                    Random.step (Random.int lo hi) acc.seed
            in
            { out = acc.out ++ [ String.padLeft 11 ' ' (String.fromInt drawn.value) ], seed = drawn.seed }
        )
        { out = [], seed = Random.initialSeed 7 }
        [ 1, 2, 3, 4, 5, 6 ]
        |> .out
        |> String.join ""
