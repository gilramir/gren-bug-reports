module Main exposing (main)

import Init
import Node exposing (Environment)
import Stream
import Task exposing (Task)


{-| `String.contains`, `startsWith`, `endsWith`, `firstIndexOf`, `lastIndexOf`
and `indices` match UTF-16 code units, so half of a surrogate pair is found
inside the character it is half of.

`𝄞` is U+1D11E, stored as the two code units 0xD834 and 0xDD1E. Neither is a
character of `"𝄞ab"`, whose characters are U+1D11E, `a` and `b`.

-}
main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram init


init : Environment -> Init.Task (Cmd a)
init env =
    Node.endSimpleProgram (report env)


{-| The string being searched: three characters.
-}
clef : String
clef =
    "𝄞ab"


{-| The character `𝄞` on its own, for the rows that are already right.
-}
clefChar : String
clefChar =
    "𝄞"


{-| The first UTF-16 code unit of `𝄞`, on its own: an unpaired lead surrogate.
-}
firstUnit : String
firstUnit =
    String.sliceUnits 0 1 clef


{-| The second: an unpaired trail surrogate.
-}
secondUnit : String
secondUnit =
    String.sliceUnits 1 2 clef


{-| The same string as `secondUnit`, built without any `*Units` function.
`Char.fromCode` takes any codepoint, and a surrogate is a codepoint.
-}
fromCode : String
fromCode =
    String.fromChar (Char.fromCode 0xDD1E)


showIndex : Maybe Int -> String
showIndex m =
    when m is
        Just n ->
            "Just " ++ String.fromInt n

        Nothing ->
            "Nothing"


showIndices : Array Int -> String
showIndices xs =
    "[" ++ String.join "," (Array.map String.fromInt xs) ++ "]"


showBool : Bool -> String
showBool b =
    if b then
        "True"

    else
        "False"


{-| One table row: the call, what it returns, and what it should return.
-}
row : String -> String -> String -> String
row call result expected =
    String.padRight 44 ' ' call
        ++ String.padRight 11 ' ' result
        ++ expected


report : Environment -> Task Never {}
report env =
    [ "clef        = \"𝄞ab\"  -- three characters: U+1D11E, a, b"
    , "clefChar    = \"𝄞\""
    , "firstUnit   = the first UTF-16 code unit of 𝄞, on its own"
    , "secondUnit  = the second"
    , "fromCode    = String.fromChar (Char.fromCode 0xDD1E) -- secondUnit again,"
    , "              built without any *Units function"
    , ""
    , row "call" "result" "expected"
    , row "----------------------------------------" "---------" "---------"
    , row "String.contains secondUnit clef" (showBool (String.contains secondUnit clef)) "False"
    , row "String.startsWith firstUnit clef" (showBool (String.startsWith firstUnit clef)) "False"
    , row "String.endsWith secondUnit clefChar" (showBool (String.endsWith secondUnit clefChar)) "False"
    , row "String.firstIndexOf secondUnit clef" (showIndex (String.firstIndexOf secondUnit clef)) "Nothing"
    , row "String.firstIndexOf firstUnit clef" (showIndex (String.firstIndexOf firstUnit clef)) "Nothing"
    , row "String.lastIndexOf secondUnit clef" (showIndex (String.lastIndexOf secondUnit clef)) "Nothing"
    , row "String.indices secondUnit clef" (showIndices (String.indices secondUnit clef)) "[]"
    , row "String.contains fromCode clef" (showBool (String.contains fromCode clef)) "False"
    , row "String.firstIndexOf fromCode clef" (showIndex (String.firstIndexOf fromCode clef)) "Nothing"
    , row "String.contains clefChar clef" (showBool (String.contains clefChar clef)) "True"
    , row "String.firstIndexOf secondUnit secondUnit" (showIndex (String.firstIndexOf secondUnit secondUnit)) "Just 0"
    ]
        |> String.join "\n"
        |> (\text -> Stream.writeLineAsBytes text env.stdout)
        |> Task.map (\_ -> {})
        |> Task.onError (\_ -> Task.succeed {})
