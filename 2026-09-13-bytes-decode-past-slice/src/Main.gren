module Main exposing (main)

import Bytes exposing (Bytes)
import Bytes.Decode as Decode
import Bytes.Encode as Encode
import Init
import Math
import Node
import Stream.Log
import Task


main : Node.Program {} {}
main =
    Node.defineProgram
        { init = init
        , update = \_ model -> { model = model, command = Cmd.none }
        , subscriptions = \_ -> Sub.none
        }


{-| A message, then a second one right after it: `[3, 10, 20, 30, 2, 40, 50]`. -}
buffer : Bytes
buffer =
    Encode.encode (Encode.sequence (Array.map Encode.unsignedInt8 [ 3, 10, 20, 30, 2, 40, 50 ]))


{-| The first message's body, `[10, 20, 30]`: a length byte, then that many bytes. -}
firstBody : Bytes
firstBody =
    Decode.decode (Decode.unsignedInt8 |> Decode.andThen Decode.bytes) buffer
        |> Maybe.withDefault Bytes.empty


showBytes : Maybe Bytes -> String
showBytes result =
    when result is
        Nothing ->
            "Nothing"

        Just bytes ->
            "Just [" ++ String.join ", " (Array.map String.fromInt (toInts bytes)) ++ "]"


{-| A decoded string, every character written as an escape, since these are control characters. -}
showString : Maybe String -> String
showString result =
    when result is
        Nothing ->
            "Nothing"

        Just string ->
            "Just \"" ++ String.foldl (\char acc -> acc ++ "\\u{" ++ hex (Char.toCode char) ++ "}") "" string ++ "\""


hex : Int -> String
hex n =
    let
        digit d =
            String.slice d (d + 1) "0123456789ABCDEF"
    in
    if n < 16 then
        digit n

    else
        hex (n // 16) ++ digit (Math.modBy 16 n)


toInts : Bytes -> Array Int
toInts bytes =
    Decode.decode (Decode.loop [] (\acc -> if Array.length acc == Bytes.length bytes then Decode.succeed (Decode.Done acc) else Decode.map (\b -> Decode.Loop (Array.pushLast b acc)) Decode.unsignedInt8)) bytes
        |> Maybe.withDefault []


row : String -> String -> String -> String
row decoder result expected =
    String.padRight 36 ' ' decoder ++ String.padRight 32 ' ' result ++ expected


init : Node.Environment -> Init.Task { model : {}, command : Cmd {} }
init env =
    Node.startProgram
        { model = {}
        , command =
            [ "Each row is Decode.decode <decoder> firstBody, and firstBody is [10, 20, 30]."
            , ""
            , row "decoder" "result" "expected"
            , row "Decode.bytes 3" (showBytes (Decode.decode (Decode.bytes 3) firstBody)) "Just [10, 20, 30]"
            , row "Decode.bytes 4" (showBytes (Decode.decode (Decode.bytes 4) firstBody)) "Nothing"
            , row "Decode.bytes 5" (showBytes (Decode.decode (Decode.bytes 5) firstBody)) "Nothing"
            , row "Decode.string 4" (showString (Decode.decode (Decode.string 4) firstBody)) "Nothing"
            , row "four Decode.unsignedInt8 (control)" (showBytes (Decode.decode (Decode.map4 (\_ _ _ _ -> Bytes.empty) Decode.unsignedInt8 Decode.unsignedInt8 Decode.unsignedInt8 Decode.unsignedInt8) firstBody)) "Nothing"
            ]
                |> Array.map (Stream.Log.line env.stdout)
                |> Task.sequence
                |> Task.execute
        }
