module Main exposing (main)

import Dict
import Json.Decode as Decode
import Json.Encode as Encode
import Node
import Stream
import Task


showPairs : Result Decode.Error (Array { key : String, value : Int }) -> String
showPairs result =
    when result is
        Ok pairs ->
            "Ok [" ++ String.join ", " (Array.map (\p -> p.key ++ " = " ++ String.fromInt p.value) pairs) ++ "]"

        Err _ ->
            "Err"


showInt : Result Decode.Error Int -> String
showInt result =
    when result is
        Ok n ->
            "Ok " ++ String.fromInt n

        Err _ ->
            "Err"


{-| Decode an object into a Dict and write the Dict back out. -}
roundTrip : String -> String
roundTrip text =
    when Decode.decodeString (Decode.dict Decode.int) text is
        Ok d ->
            Encode.encode 0 (Encode.dict identity Encode.int d)

        Err _ ->
            "Err"


rows : Array { call : String, result : String, expected : String }
rows =
    [ { call = "decodeString (keyValuePairs int) \"{\\\"__proto__\\\":1,\\\"a\\\":2}\""
      , result = showPairs (Decode.decodeString (Decode.keyValuePairs Decode.int) "{\"__proto__\":1,\"a\":2}")
      , expected = "Ok [__proto__ = 1, a = 2]"
      }
    , { call = "the same object through dict int, then Encode.dict"
      , result = roundTrip "{\"__proto__\":1,\"a\":2}"
      , expected = "{\"__proto__\":1,\"a\":2}"
      }
    , { call = "encode 0 (object [ { key = \"__proto__\", value = int 1 } ])"
      , result = Encode.encode 0 (Encode.object [ { key = "__proto__", value = Encode.int 1 } ])
      , expected = "{\"__proto__\":1}"
      }
    , { call = "encode 0 (object [ { key = \"__proto__\", value = object [ { key = \"x\", value = int 1 } ] } ])"
      , result = Encode.encode 0 (Encode.object [ { key = "__proto__", value = Encode.object [ { key = "x", value = Encode.int 1 } ] } ])
      , expected = "{\"__proto__\":{\"x\":1}}"
      }
    , { call = "decodeValue (field \"x\" int) (object [ { key = \"__proto__\", value = object [ { key = \"x\", value = int 1 } ] } ])"
      , result = showInt (Decode.decodeValue (Decode.field "x" Decode.int) (Encode.object [ { key = "__proto__", value = Encode.object [ { key = "x", value = Encode.int 1 } ] } ]))
      , expected = "Err"
      }
    ]


main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram
        (\env ->
            Node.endSimpleProgram
                (Stream.writeLineAsBytes
                    (String.join "\n"
                        ([ "| call | result | expected |", "|---|---|---|" ]
                            ++ Array.map (\r -> "| `" ++ String.replace "|" "\\|" r.call ++ "` | " ++ r.result ++ " | " ++ r.expected ++ " |") rows
                        )
                    )
                    env.stdout
                    |> Task.map (\_ -> {})
                    |> Task.onError (\_ -> Task.succeed {})
                )
        )
