module Main exposing (main)

{-| Cancel a task twice, once with `Process.kill` and once by failing a sibling
in `Task.concurrent`, while it is waiting on `FileSystem.readFile`. Neither
cancelled task should print anything.
-}

import Bytes exposing (Bytes)
import FileSystem
import FileSystem.Path as Path
import Init
import Node
import Process
import Stream
import Task exposing (Task)


main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram <| \env ->
        Init.await FileSystem.initialize <| \fsPerm ->
            Node.endSimpleProgram (run env.stdout fsPerm)


run : Stream.Writable Bytes -> FileSystem.Permission -> Task Never {}
run stdout fsPerm =
    let
        say text =
            Stream.writeLineAsBytes text stdout
                |> Task.map (\_ -> {})
                |> Task.onError (\_ -> Task.succeed {})

        read =
            FileSystem.readFile fsPerm (Path.fromPosixString "app")
    in
    say "1. Process.kill"
        |> Task.andThen (\_ -> Process.spawn (read |> Task.andThen (\_ -> say "   the killed process ran on")))
        |> Task.andThen Process.kill
        |> Task.andThen (\_ -> say "   killed")
        |> Task.andThen (\_ -> Process.sleep 500)
        |> Task.andThen (\_ -> say "2. Task.concurrent")
        |> Task.andThen
            (\_ ->
                Task.concurrent
                    [ read
                        |> Task.mapError (\_ -> "read failed")
                        |> Task.andThen (\_ -> say "   the cancelled sibling ran on")
                    , Task.fail "the other task failed"
                    ]
                    |> Task.map (\_ -> {})
                    |> Task.onError (\e -> say ("   concurrent failed: " ++ e))
            )
        |> Task.andThen (\_ -> Process.sleep 500)
        |> Task.andThen (\_ -> say "done")
