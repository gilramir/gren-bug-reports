module Main exposing (main)

{-| `ChildProcess.spawn` with `NoShell` and arguments.

Each row spawns a program with `Ignored` streams and prints the exit code the
`onExit` message receives. The first two rows use a shell, the last two do not;
only the last one passes arguments without a shell.
-}

import Bytes exposing (Bytes)
import ChildProcess exposing (Connection(..), Shell(..))
import Init
import Node
import Stream
import Task


type alias Row =
    { label : String
    , shell : Shell
    , program : String
    , arguments : Array String
    }


rows : Array Row
rows =
    [ { label = "DefaultShell, true, no arguments", shell = DefaultShell, program = "true", arguments = [] }
    , { label = "DefaultShell, test, [\"1\", \"-eq\", \"1\"]", shell = DefaultShell, program = "test", arguments = [ "1", "-eq", "1" ] }
    , { label = "NoShell, true, no arguments", shell = NoShell, program = "true", arguments = [] }
    , { label = "NoShell, test, [\"1\", \"-eq\", \"1\"]", shell = NoShell, program = "test", arguments = [ "1", "-eq", "1" ] }
    ]


type Msg
    = Started
    | Next Int
    | Exited { index : Int, code : Int }


type alias Model =
    { permission : ChildProcess.Permission
    , stdout : Stream.Writable Bytes
    }


main : Node.Program Model Msg
main =
    Node.defineProgram
        { init = init
        , update = update
        , subscriptions = \_ -> Sub.none
        }


init : Node.Environment -> Init.Task { model : Model, command : Cmd Msg }
init env =
    Init.await ChildProcess.initialize <| \permission ->
        Node.startProgram
            { model = { permission = permission, stdout = env.stdout }
            , command =
                Stream.writeLineAsBytes "| spawn | exit code | expected |\n|---|---|---|" env.stdout
                    |> Task.attempt (\_ -> Next 0)
            }


spawnRow : ChildProcess.Permission -> Int -> Cmd Msg
spawnRow permission index =
    when Array.get index rows is
        Nothing ->
            Cmd.none

        Just r ->
            ChildProcess.spawn permission
                r.program
                r.arguments
                { shell = r.shell
                , workingDirectory = ChildProcess.InheritWorkingDirectory
                , environmentVariables = ChildProcess.InheritEnvironmentVariables
                , runDuration = ChildProcess.NoLimit
                , connection = Ignored (\_ -> Started)
                , onExit = \code -> Exited { index = index, code = code }
                }


update : Msg -> Model -> { model : Model, command : Cmd Msg }
update msg model =
    when msg is
        Started ->
            { model = model, command = Cmd.none }

        Exited { index, code } ->
            { model = model
            , command =
                when Array.get index rows is
                    Just r ->
                        Stream.writeLineAsBytes ("| " ++ r.label ++ " | " ++ String.fromInt code ++ " | 0 |") model.stdout
                            |> Task.attempt (\_ -> Next (index + 1))

                    Nothing ->
                        Cmd.none
            }

        Next index ->
            { model = model, command = spawnRow model.permission index }
