module Main exposing (main)

import Node
import Stream
import Task


pick : a -> a -> Int -> a
pick x y n =
    let
        first k =
            if k <= 0 then
                x

            else
                second (k - 1)

        second k =
            if k <= 0 then
                y

            else
                first (k - 1)
    in
    first n


main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram <| \env ->
        Node.endSimpleProgram
            (Stream.writeLineAsBytes (pick "x" "y" 3) env.stdout
                |> Task.map (\_ -> {})
                |> Task.onError (\_ -> Task.succeed {})
            )
