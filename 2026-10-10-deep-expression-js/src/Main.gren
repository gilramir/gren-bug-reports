module Main exposing (main)

import Node
import Stream
import Task


main : Node.SimpleProgram a
main =
    Node.defineSimpleProgram <| \env ->
        Node.endSimpleProgram
            (Stream.writeLineAsBytes (String.fromInt value) env.stdout
                |> Task.map (\_ -> {})
                |> Task.onError (\_ -> Task.succeed {})
            )


value : Int
value =
    0
        + 1
        + 2
        + 3
        + 4

